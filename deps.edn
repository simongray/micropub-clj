{:paths ["src"]

 ;; Clojure 1.11 is the floor, and the tests run on it unless an alias says
 ;; otherwise. wary-fetch reads and writes JSON and sends the client's
 ;; requests, html-pieces reads the links of a page, whatwg-url resolves
 ;; URLs, whatwg-mime reads media types, and indieauth-clj checks access
 ;; tokens.
 :deps  {org.clojure/clojure        {:mvn/version "1.11.4"}
         dk.simongray/wary-fetch    {:mvn/version "0.8.1"}
         dk.simongray/html-pieces   {:mvn/version "0.6.0"}
         dk.simongray/whatwg-url    {:mvn/version "0.1.0"}
         dk.simongray/whatwg-mime   {:mvn/version "0.2.1"}
         dk.simongray/indieauth-clj {:mvn/version "0.2.1"}}

 :aliases
 {;; clojure -X:test
  :test  {:extra-paths ["test"]
          :extra-deps  {io.github.cognitect-labs/test-runner
                        {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
          :main-opts   ["-m" "cognitect.test-runner"]
          :exec-fn     cognitect.test-runner.api/test}

  ;; clojure -M:cljs compile test  (the tests in Node)
  :cljs  {:extra-paths   ["test"]
          :override-deps {org.clojure/clojure {:mvn/version "1.12.5"}}
          :extra-deps    {thheller/shadow-cljs {:mvn/version "3.5.3"}}
          :main-opts     ["-m" "shadow.cljs.devtools.cli"]}

  ;; clojure -M:nrepl  (a REPL for development, with the tests)
  :nrepl {:extra-paths ["test"]
          :extra-deps  {nrepl/nrepl {:mvn/version "1.7.0"}}
          :jvm-opts    ["-Djdk.attach.allowAttachSelf"]
          :main-opts   ["-m" "nrepl.cmdline"]}

  ;; clojure -T:build jar | install | deploy  (see build.clj)
  :build {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.14"}
                       slipset/deps-deploy            {:mvn/version "0.2.5"}}
          :ns-default build}}}
